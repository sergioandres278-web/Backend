# ====================================================================
# AGENCYTRIP CO — VARIABLES DE ENTORNO PARA DOCKER (.env)
# ====================================================================
# Copie este archivo como '.env' en la raíz de su entorno Docker.
# IMPORTANTE: Nunca suba el archivo '.env' con secretos reales a Git.

# --- Conexión a Base de Datos MySQL (Host o Contenedor) ---
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=agencia_viajes
DB_URL=jdbc:mysql://localhost:3306/agencia_viajes
DB_USERNAME=REPLACE_WITH_LOCAL_DB_USERNAME
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD

# --- Seguridad Spring Security y JWT ---
# Se requiere una clave secreta HMAC-SHA de al menos 256 bits codificada en Base64
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET
JWT_ISSUER=AgencyTripAPI
JWT_AUDIENCE=AgencyTripAngular

# --- Puertos de Servicios en el Host ---
PORT=8080
CHATBOT_PORT=8081
FRONTEND_PORT=4200

# --- Integración Interna entre Contenedores ---
AGENCYTRIP_API_URL=http://agencytrip-api:8080
CHATBOT_CORS_ALLOWED_ORIGIN=http://localhost:4200
